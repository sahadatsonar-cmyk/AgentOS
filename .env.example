# Database (Supabase pooler recommended on Vercel)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth (later)
NEXTAUTH_SECRET="generate-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# LLM Providers — optional for Phase 4 final answers
XAI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Phase 7 — require human approval for high-risk tools
# AGENTOS_REQUIRE_APPROVAL="true"

# Phase 8 — coding agent
# Fine-scoped GitHub token (contents:read) for github_get_file / github_list_dir
GITHUB_TOKEN=""
# Only on trusted local/worker hosts — never enable on public serverless by default
# AGENTOS_ENABLE_SHELL="true"

# Optional
REDIS_URL="redis://localhost:6379"
