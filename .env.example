OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Phase 7 — require human approval for high-risk tools (web_fetch, code)
# AGENTOS_REQUIRE_APPROVAL="true"

# Optional
REDIS_URL="redis://localhost:6379"
